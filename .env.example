# Browser-safe. The anon key is public; row level security limits what it can do.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix this with NEXT_PUBLIC_ and never import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used in auth email links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Encrypts the Supabase refresh token stored for each Claude connection.
# Generate with: openssl rand -base64 32
MCP_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64

# Used only by `npm run db:seed-demo`. Not read by the app.
# Replace the email if the Supabase project rejects example.com addresses.
DEMO_LANDLORD_EMAIL=jamie.sample@example.com
DEMO_LANDLORD_PASSWORD=choose-a-long-password
